 .../overlay/usr/local/bin/steam-compatibility | 14 ++-
 tools/tests/test_game_environment.py          | 27 ++++++
 3 files changed, 133 insertions(+), 2 deletions(-)
 create mode 100755 tools/linuxfs/overlay/usr/local/bin/droiddeck-qpc-timer

