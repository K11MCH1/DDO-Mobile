#!/usr/bin/python3
"""Starts Dungeons & Dragons Online under Proton, without the Steam client.

    ddo-run --args-file PATH

PATH is a JSON request the app writes just before the session starts:
{"proton": "<Proton folder>", "prefix": "<compat data folder>", "dir": "<install folder>", "exe": "<client exe>",
 "args": [...], "env": {...}, "prefs": "<UserPreferences.ini>"}
The client's arguments carry the account's login ticket, so they travel in this file rather than on a command
line, and the file is removed as soon as it is read.
"""
import hashlib
import json
import os
import re
import shutil
import stat
import sys

FEX_BUILD = "/usr/local/lib/ddo-mobile/libarm64ecfex.dll"
# FEX stamps its version in more than one form, e.g. FEX-2610-30-g741e146 and FEX-2610e146.
FEX_VERSION = re.compile(rb"FEX-\d{4}[0-9A-Za-z-]*")
# Exported only by FEX with DroidDeck-Proton's patch series, which runtime/fex builds on.
DROIDDECK_FEX = b"BTCpu64NotifyNonImageViews"

# ntdll.dll builds by SHA-256 -> (file offset, original bytes, new bytes) for patch_ntdll_timer.
NTDLL_TIMER = {
    # DroidDeck-Proton 11-11.9
    "18e970a8d2fdde2496d197b52eb80e87626e169a00b986dbe2c3d918839cfaf6": [
        # #RtlQueryPerformanceCounter: mrs x8, cntvct_el0; str x8, [x0]; mov w0, #1; ret
        (0xdf350, "fd7bbfa9fd030091e1031faaed470094", "48e03bd5080000f920008052c0035fd6"),
        # #RtlQueryPerformanceFrequency: mrs x8, cntfrq_el0; str x8, [x0]; mov w0, #1; ret
        (0xdf370, "08d092520813a072080000f920008052", "08e03bd5080000f920008052c0035fd6"),
        # #NtQueryPerformanceCounter$hp_target (the system call stub): both from the timer, STATUS_SUCCESS
        (0xccbe0, "280680d2e9031eaa50ba41f9700000b4100640f9700000b5d0040090",
         "48e03bd5080000f9610000b408e03bd5280000f9e0031f2ac0035fd6"),
    ],
}


def say(message):
    print("ddo-run: %s" % message, file=sys.stderr, flush=True)


def load(path):
    try:
        with open(path, encoding="utf-8") as f:
            request = json.load(f)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    if not isinstance(request, dict):
        raise ValueError("not an object")
    return request


def fit_display(prefs):
    """Gives the client the session's own output size, so gamescope shows it edge to edge."""
    try:
        width, height = int(os.environ["DDO_WIDTH"]), int(os.environ["DDO_HEIGHT"])
    except (KeyError, ValueError):
        return
    if width <= 0 or height <= 0 or not os.path.isfile(prefs):
        return
    wanted = {"Resolution": "%dx%d" % (width, height), "WindowedResolution": str(width << 16 | height),
              "FullScreen": "True"}
    with open(prefs, encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()
    out, section, seen = [], None, set()
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if section == "Display":
                out.extend("%s=%s" % (k, v) for k, v in wanted.items() if k not in seen)
            section = stripped[1:-1]
        elif section == "Display" and "=" in stripped and stripped.split("=", 1)[0] in wanted:
            key = stripped.split("=", 1)[0]
            seen.add(key)
            line = "%s=%s" % (key, wanted[key])
        out.append(line)
    if section == "Display":
        out.extend("%s=%s" % (k, v) for k, v in wanted.items() if k not in seen)
    elif "Display" not in {l.strip()[1:-1] for l in lines if l.strip().startswith("[")}:
        out += ["", "[Display]"] + ["%s=%s" % (k, v) for k, v in wanted.items()]
    with open(prefs, "w", encoding="utf-8", newline="\r\n") as f:
        f.write("\n".join(out) + "\n")
    say("display set to %dx%d" % (width, height))


def big_cores():
    """The cores the game and Wine run on: not the little cluster, and not a cluster the vendor holds below a smaller
    one. vivo, for one, caps an app's prime core under its mid cores and parks it near its minimum clock."""
    hw, cap = {}, {}
    for name in os.listdir("/sys/devices/system/cpu"):
        if not (name.startswith("cpu") and name[3:].isdigit()):
            continue
        base = "/sys/devices/system/cpu/%s/cpufreq/" % name
        try:
            with open(base + "cpuinfo_max_freq") as f:
                hw[int(name[3:])] = int(f.read())
            with open(base + "scaling_max_freq") as f:
                cap[int(name[3:])] = int(f.read())
        except (OSError, ValueError):
            pass
    if len(set(hw.values())) < 2:
        return []
    slowest = min(hw.values())
    chosen = []
    for c in sorted(hw):
        if hw[c] == slowest:
            continue
        held_back = any(hw[o] < hw[c] and hw[o] > slowest and cap[o] > cap[c] for o in hw)
        if not held_back:
            chosen.append(c)
    if len(chosen) < 4:
        # A phone without a little cluster - the RedMagic 11 Pro has six 3.6 GHz cores and two 4.6 GHz - would leave the
        # game, Wine and DXVK two cores between them. Every core then, the fastest first as Windows numbers them.
        chosen = sorted(hw, key=lambda c: (-hw[c], c))
    return chosen


def use_runtime_fex(proton_dir):
    """Puts the runtime's FEX (runtime/fex) in place of the Proton's own. That build is DroidDeck-Proton's FEX plus
    fixes for running under Wine, so it only goes into a Proton whose FEX is the same version with the same series;
    the Proton's file is kept beside it as .orig."""
    theirs = os.path.join(proton_dir, "files", "lib", "wine", "aarch64-windows", "libarm64ecfex.dll")
    original = theirs + ".orig"
    if not os.path.isfile(FEX_BUILD) or not os.path.isfile(theirs):
        return
    with open(FEX_BUILD, "rb") as f:
        ours = f.read()
    with open(original if os.path.isfile(original) else theirs, "rb") as f:
        stock = f.read()

    def identity(data):
        return tuple(sorted(set(FEX_VERSION.findall(data)))), DROIDDECK_FEX in data

    def version(data):
        return max(identity(data)[0], key=len, default=b"no FEX version").decode()

    if not identity(ours)[0] or identity(stock) != identity(ours):
        why = ("it is %s, DDO Mobile's is %s" % (version(stock), version(ours)) if identity(stock)[0] != identity(ours)[0]
               else "it is not DroidDeck-Proton's FEX")
        say("keeping %s's own FEX: %s" % (os.path.basename(proton_dir), why))
        return
    if put_in_place(theirs, ours):
        say("using DDO Mobile's build of %s" % version(ours))


def patch_ntdll_timer(proton_dir):
    """Windows on ARM answers QueryPerformanceCounter from the CPU's generic timer without leaving user space; Wine's
    ARM64EC ntdll makes a system call for each one, and DDO makes hundreds of thousands a second while it loads. The
    Windows side's counter, frequency and NtQueryPerformanceCounter stub are pointed at the timer instead. Wine's
    Linux side keeps its own 100 ns counter, which its timeouts are built on, and its Windows-side users all take the
    frequency along with the counter."""
    path = os.path.join(proton_dir, "files", "lib", "wine", "aarch64-windows", "ntdll.dll")
    if not os.path.isfile(path):
        return
    original = path + ".orig"
    with open(original if os.path.isfile(original) else path, "rb") as f:
        stock = f.read()
    patches = NTDLL_TIMER.get(hashlib.sha256(stock).hexdigest())
    if patches is None:
        say("keeping %s's own QueryPerformanceCounter: not an ntdll.dll DDO Mobile knows" % os.path.basename(proton_dir))
        return
    patched = bytearray(stock)
    for offset, old, new in patches:
        old, new = bytes.fromhex(old), bytes.fromhex(new)
        if stock[offset:offset + len(old)] != old:
            say("keeping %s's own QueryPerformanceCounter: ntdll.dll differs at %#x" % (os.path.basename(proton_dir), offset))
            return
        patched[offset:offset + len(new)] = new
    if put_in_place(path, bytes(patched)):
        say("QueryPerformanceCounter reads the CPU timer")


def put_in_place(path, data):
    """Replaces a file of the Proton with data, keeping the Proton's own beside it as .orig. False when already done."""
    with open(path, "rb") as f:
        if f.read() == data:
            return False
    original = path + ".orig"
    if not os.path.isfile(original):
        shutil.copy2(path, original)
    staged = path + ".ddo-new"
    with open(staged, "wb") as f:
        f.write(data)
    os.chmod(staged, stat.S_IMODE(os.stat(original).st_mode))
    os.replace(staged, path)
    return True


def main(argv):
    if len(argv) != 2 or argv[0] != "--args-file":
        say("usage: ddo-run --args-file PATH")
        return 2
    try:
        request = load(argv[1])
    except (OSError, ValueError) as e:
        say("could not read the launch request: %s" % e)
        return 2
    proton = os.path.join(request.get("proton") or "", "proton")
    prefix = request.get("prefix") or ""
    folder = request.get("dir") or ""
    exe = request.get("exe") or ""
    args = [str(a) for a in request.get("args") or []]
    if not os.access(proton, os.X_OK):
        say("Proton is not installed at %s" % os.path.dirname(proton))
        return 2
    if not os.path.isfile(exe) or not os.path.isdir(folder) or not prefix:
        say("the game is not where the launcher expected it (%s)" % exe)
        return 2
    for tune in (use_runtime_fex, patch_ntdll_timer):
        try:
            tune(os.path.dirname(proton))
        except OSError as e:
            say("could not update the Proton (%s): %s" % (tune.__name__, e))
    os.makedirs(prefix, exist_ok=True)
    steam = os.path.join(os.environ.get("HOME", "/root"), ".local", "share", "Steam")
    os.makedirs(steam, exist_ok=True)
    env = dict(os.environ)
    env.update({
        "STEAM_COMPAT_DATA_PATH": prefix,
        "STEAM_COMPAT_CLIENT_INSTALL_PATH": steam,
        "STEAM_COMPAT_INSTALL_PATH": folder,
        "STEAM_COMPAT_TOOL_PATHS": os.path.dirname(proton),
        "STEAM_COMPAT_APP_ID": "0",
        "SteamAppId": "0",
        "SteamGameId": "0",
        "PROTON_LOG_DIR": os.path.join(prefix, "logs"),
        # KGSL maps host-visible memory uncached by default, which makes every CPU read of it crawl.
        "tu_override_uncached_as_cache_coherent": "true",
        "vblank_mode": "0",
        # Larger audio periods: fewer wake-ups across Wine, PulseAudio and the AAudio sink, which together kept
        # about 40% of a core busy with the default short periods.
        "PULSE_LATENCY_MSEC": "60",
    })
    audit = "/usr/local/lib/libddoaudit.so"
    if env.get("PROOT_FP_KEY") and os.path.isfile(audit):
        # Paired with the proot fast path for Proton's processes, as DroidDeck's Proton wrapper does.
        env["LD_AUDIT"] = audit + (":" + env["LD_AUDIT"] if env.get("LD_AUDIT") else "")
    cores = big_cores()
    if cores:
        env["WINE_CPU_TOPOLOGY"] = env["PROTON_CPU_TOPOLOGY"] = "%d:%s" % (len(cores), ",".join(map(str, cores)))
        try:
            os.sched_setaffinity(0, cores)
        except OSError as e:
            say("could not keep to cores %s: %s" % (cores, e))
        say("game cores %s" % ",".join(map(str, cores)))
    env.update({str(k): str(v) for k, v in (request.get("env") or {}).items()})
    if request.get("prefs"):
        fit_display(str(request["prefs"]))
    say("starting %s with %s, %d arguments" % (os.path.basename(exe), os.path.basename(os.path.dirname(proton)), len(args)))
    os.chdir(folder)
    os.execve(proton, [proton, "waitforexitandrun", exe] + args, env)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
