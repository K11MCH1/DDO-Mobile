   static void ClearICache(void* Begin, std::size_t Length) {
+#ifdef _WIN32
+    // On Windows targets __builtin___clear_cache becomes FlushInstructionCache: under Wine a system call, plus a
+    // callback into FEX's own code invalidation, for every compiled or linked block. Wine always runs us on Linux,
+    // which lets user space maintain the caches itself, as compiler-rt does there.
+    static const uint64_t CTR = [] {
+      uint64_t Value;
+      __asm__ volatile("mrs %0, ctr_el0" : "=r"(Value));
+      return Value;
+    }();
+    const uintptr_t Start = reinterpret_cast<uintptr_t>(Begin);
+    const uintptr_t End = Start + Length;
+    if (!(CTR & (1ULL << 28))) { // IDC clear: clean the data cache to the point of unification
+      const uintptr_t Line = 4ULL << ((CTR >> 16) & 0xf);
+      for (uintptr_t Addr = Start & ~(Line - 1); Addr < End; Addr += Line) {
+        __asm__ volatile("dc cvau, %0" ::"r"(Addr) : "memory");
+      }
+    }
+    __asm__ volatile("dsb ish" ::: "memory");
+    if (!(CTR & (1ULL << 29))) { // DIC clear: invalidate the instruction cache
+      const uintptr_t Line = 4ULL << (CTR & 0xf);
+      for (uintptr_t Addr = Start & ~(Line - 1); Addr < End; Addr += Line) {
+        __asm__ volatile("ic ivau, %0" ::"r"(Addr) : "memory");
+      }
+      __asm__ volatile("dsb ish" ::: "memory");
+    }
+    __asm__ volatile("isb" ::: "memory");
+#else
     __builtin___clear_cache(static_cast<char*>(Begin), static_cast<char*>(Begin) + Length);
+#endif
   }
 
